{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katana.invalid/schemas/native-bringup-cycle-manifest-v2.json",
  "title": "Katana NativeBringup knowledge-gap cycle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cycle",
    "workflow",
    "frozen_utc",
    "world_sha256",
    "aot_pack_sha256",
    "runtime_commit_or_source_identity",
    "replay_set_sha256",
    "current_milestone",
    "target_milestone",
    "replays",
    "knowledge_gap_clusters",
    "performance_companion",
    "product_build_budget",
    "analysis_required"
  ],
  "properties": {
    "schema": {
      "const": "katana-native-bringup-cycle-manifest-v2"
    },
    "cycle": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "enum": ["macro", "micro"]
    },
    "frozen_utc": {
      "type": "string",
      "format": "date-time"
    },
    "world_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "aot_pack_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_commit_or_source_identity": {
      "type": "string",
      "minLength": 1
    },
    "replay_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "current_milestone": {
      "$ref": "#/$defs/milestone"
    },
    "target_milestone": {
      "$ref": "#/$defs/milestone"
    },
    "replays": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "knowledge_class",
          "stop_signature",
          "reached_checkpoint",
          "root_cause_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_class": {
            "$ref": "#/$defs/knowledge_class"
          },
          "stop_signature": {
            "type": "string",
            "minLength": 1
          },
          "reached_checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "root_cause_key": {
            "type": "string",
            "minLength": 1
          },
          "active_frontier_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        }
      }
    },
    "knowledge_gap_clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "knowledge_classes",
          "replay_ids",
          "origin",
          "story_reachability",
          "multi_close",
          "implementation_risk",
          "implementation_scope"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/knowledge_class"
            }
          },
          "replay_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "frontier_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "origin": {
            "enum": [
              "generic-analyzer",
              "private-title-evidence",
              "runtime-contract",
              "provider-contract",
              "runtime-semantics",
              "native-presentation"
            ]
          },
          "story_reachability": {
            "type": "string",
            "minLength": 1
          },
          "multi_close": {
            "type": "integer",
            "minimum": 1
          },
          "implementation_risk": {
            "enum": ["low", "medium", "high"]
          },
          "implementation_scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "performance_companion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_cause_key", "target", "acceptance", "same_path"],
      "properties": {
        "root_cause_key": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "acceptance": {
          "type": "string",
          "minLength": 1
        },
        "same_path": {
          "const": true
        }
      }
    },
    "graphics_root_cause_cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "inclusion_reason"],
      "properties": {
        "category": {
          "enum": [
            "submission-missing",
            "geometry-disappears",
            "wrong-asset",
            "wrong-render-state",
            "wrong-shader-contract",
            "wrong-order"
          ]
        },
        "inclusion_reason": {
          "enum": [
            "bringup-blocking",
            "multi-scene",
            "generic-renderer",
            "crash",
            "diagnosis-obscured",
            "performance-dual-close"
          ]
        }
      }
    },
    "product_build_budget": {
      "const": 1
    },
    "analysis_required": {
      "type": "boolean"
    },
    "analysis_event": {
      "type": "string",
      "minLength": 1
    },
    "a_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "late_findings_policy": {
      "const": "next-cycle"
    },
    "performance_diagnostics_mode": {
      "const": "off"
    },
    "maximum_parallel_crash_replays": {
      "const": 2
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow": {
            "const": "macro"
          }
        }
      },
      "then": {
        "required": ["analysis_event"],
        "properties": {
          "analysis_required": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "milestone": {
      "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8"]
    },
    "knowledge_class": {
      "enum": ["K1", "K2", "K3", "K4", "K5"]
    }
  }
}
