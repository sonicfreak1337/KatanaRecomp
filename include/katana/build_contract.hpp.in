#pragma once

#include "katana/abi_contract.hpp"

#include <string_view>

namespace katana::build_contract {

inline constexpr std::string_view project_version = "@KATANA_PROJECT_VERSION@";
inline constexpr std::string_view katana_git_commit = "@KATANA_GIT_COMMIT@";
inline constexpr bool source_identity_trusted =
    @KATANA_SOURCE_IDENTITY_TRUSTED@ != 0;
inline constexpr std::string_view configured_compiler_launcher =
    "@KATANA_CONFIGURED_COMPILER_LAUNCHER@";

// Compatibility aliases for tooling that consumes provenance and ABI values
// together. Generated AOT code includes abi_contract.hpp directly.
inline constexpr std::uint32_t runtime_abi_version =
    abi_contract::runtime_abi_version;
inline constexpr std::uint32_t block_abi_version =
    abi_contract::block_abi_version;
inline constexpr std::uint32_t analyzer_abi_version =
    abi_contract::analyzer_abi_version;
inline constexpr std::uint32_t platform_services_abi_version =
    abi_contract::platform_services_abi_version;
inline constexpr std::uint32_t backend_interface_abi_version =
    abi_contract::backend_interface_abi_version;
inline constexpr std::uint32_t port_project_contract_version =
    abi_contract::port_project_contract_version;
inline constexpr std::uint32_t native_port_profile_contract_version =
    abi_contract::native_port_profile_contract_version;

} // namespace katana::build_contract
