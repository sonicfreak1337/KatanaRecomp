if(WIN32)
    function(_katana_ffmpeg_build_import component dll_file library_file)
        if(TARGET KatanaFfmpeg::${component})
            return()
        endif()
        add_library(KatanaFfmpeg::${component} SHARED IMPORTED)
        set_target_properties(
            KatanaFfmpeg::${component}
            PROPERTIES IMPORTED_LOCATION "${dll_file}" IMPORTED_IMPLIB "${library_file}"
        )
    endfunction()
    _katana_ffmpeg_build_import(avformat "@KATANA_FFMPEG_ROOT@/bin/avformat-62.dll" "@KATANA_FFMPEG_ROOT@/lib/avformat.lib")
    _katana_ffmpeg_build_import(avcodec "@KATANA_FFMPEG_ROOT@/bin/avcodec-62.dll" "@KATANA_FFMPEG_ROOT@/lib/avcodec.lib")
    _katana_ffmpeg_build_import(avutil "@KATANA_FFMPEG_ROOT@/bin/avutil-60.dll" "@KATANA_FFMPEG_ROOT@/lib/avutil.lib")
    _katana_ffmpeg_build_import(swresample "@KATANA_FFMPEG_ROOT@/bin/swresample-6.dll" "@KATANA_FFMPEG_ROOT@/lib/swresample.lib")
    _katana_ffmpeg_build_import(swscale "@KATANA_FFMPEG_ROOT@/bin/swscale-9.dll" "@KATANA_FFMPEG_ROOT@/lib/swscale.lib")
    set_property(TARGET KatanaFfmpeg::swresample PROPERTY INTERFACE_LINK_LIBRARIES KatanaFfmpeg::avutil)
    set_property(TARGET KatanaFfmpeg::swscale PROPERTY INTERFACE_LINK_LIBRARIES KatanaFfmpeg::avutil)
    set_property(TARGET KatanaFfmpeg::avcodec PROPERTY INTERFACE_LINK_LIBRARIES "KatanaFfmpeg::avutil;KatanaFfmpeg::swresample")
    set_property(TARGET KatanaFfmpeg::avformat PROPERTY INTERFACE_LINK_LIBRARIES "KatanaFfmpeg::avcodec;KatanaFfmpeg::avutil")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/KatanaRuntimeBuildTargetsImpl.cmake")

# Switching between ABI-compatible runtime compiler builds need not change
# every generated AOT compile command. Only the two public SDK contract
# headers may reuse a previous include directory, after an exact byte check.
# Runtime objects still compile against their own build's generated headers;
# this does not substitute source/component provenance for either build.
set(KATANA_RUNTIME_ABI_INCLUDE_DIRECTORY "" CACHE PATH
    "Existing byte-identical public runtime contract include directory")
if(KATANA_RUNTIME_ABI_INCLUDE_DIRECTORY)
    file(REAL_PATH "${KATANA_RUNTIME_ABI_INCLUDE_DIRECTORY}"
        _katana_reused_contract_include)
    set(_katana_current_contract_include
        "${CMAKE_CURRENT_LIST_DIR}/generated/include")
    foreach(_katana_contract_header IN ITEMS abi_contract.hpp build_contract.hpp)
        set(_katana_current_contract
            "${_katana_current_contract_include}/katana/${_katana_contract_header}")
        set(_katana_reused_contract
            "${_katana_reused_contract_include}/katana/${_katana_contract_header}")
        if(NOT EXISTS "${_katana_current_contract}" OR
           NOT EXISTS "${_katana_reused_contract}")
            message(FATAL_ERROR "Runtime contract include reuse requires both SDK headers")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
            "${_katana_current_contract}" "${_katana_reused_contract}")
        file(SHA256 "${_katana_current_contract}" _katana_current_contract_sha)
        file(SHA256 "${_katana_reused_contract}" _katana_reused_contract_sha)
        if(NOT _katana_current_contract_sha STREQUAL _katana_reused_contract_sha)
            message(FATAL_ERROR
                "Runtime contract include reuse differs: ${_katana_contract_header}")
        endif()
    endforeach()
    foreach(_katana_runtime_target IN ITEMS
            KatanaRecomp::aot_runtime KatanaRecomp::native_port_runtime)
        get_target_property(_katana_runtime_includes
            ${_katana_runtime_target} INTERFACE_INCLUDE_DIRECTORIES)
        list(FIND _katana_runtime_includes
            "${_katana_current_contract_include}" _katana_contract_include_index)
        if(_katana_contract_include_index EQUAL -1)
            message(FATAL_ERROR "Runtime export omitted its contract include directory")
        endif()
        list(REMOVE_AT _katana_runtime_includes ${_katana_contract_include_index})
        list(INSERT _katana_runtime_includes ${_katana_contract_include_index}
            "${_katana_reused_contract_include}")
        set_property(TARGET ${_katana_runtime_target} PROPERTY
            INTERFACE_INCLUDE_DIRECTORIES "${_katana_runtime_includes}")
    endforeach()
endif()

if(WIN32 AND TARGET KatanaRecomp::KatanaFfmpegBuild)
    function(katana_deploy_ffmpeg_runtime target)
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "katana_deploy_ffmpeg_runtime target does not exist: ${target}")
        endif()
        add_custom_command(
            TARGET "${target}"
            POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                $<TARGET_RUNTIME_DLLS:${target}>
                $<TARGET_FILE_DIR:${target}>
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "@KATANA_FFMPEG_ROOT@/LICENSE.txt"
                "$<TARGET_FILE_DIR:${target}>/FFmpeg-LGPL.txt"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "@KATANA_FFMPEG_NOTICE_FILE@"
                "$<TARGET_FILE_DIR:${target}>/FFmpeg-NOTICE.txt"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "@KATANA_FFMPEG_BUILD_CONFIGURATION_FILE@"
                "$<TARGET_FILE_DIR:${target}>/FFmpeg-BUILD-CONFIGURATION.txt"
            COMMAND ${CMAKE_COMMAND} -E rm -f
                "$<TARGET_FILE_DIR:${target}>/FFmpeg-Corresponding-Source.zip"
                "$<TARGET_FILE_DIR:${target}>/FFmpeg-DEVELOPMENT-ONLY.txt"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "@KATANA_FFMPEG_REDISTRIBUTION_FILE@"
                "$<TARGET_FILE_DIR:${target}>/@KATANA_FFMPEG_REDISTRIBUTION_FILENAME@"
            COMMAND_EXPAND_LISTS
            VERBATIM
        )
    endfunction()
    if(NOT TARGET katana_ffmpeg_runtime_files)
        function(_katana_add_ffmpeg_runtime_output source destination_name)
            set(_katana_ffmpeg_output
                "${CMAKE_BINARY_DIR}/${destination_name}")
            add_custom_command(
                OUTPUT "${_katana_ffmpeg_output}"
                COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    "${source}"
                    "${_katana_ffmpeg_output}"
                DEPENDS "${source}"
                COMMENT "Deploy pinned FFmpeg runtime file ${destination_name}"
                VERBATIM
            )
            set(_katana_ffmpeg_runtime_outputs
                ${_katana_ffmpeg_runtime_outputs}
                "${_katana_ffmpeg_output}"
                PARENT_SCOPE
            )
        endfunction()

        set(_katana_ffmpeg_runtime_outputs)
        foreach(_katana_ffmpeg_runtime_file IN ITEMS
                @KATANA_FFMPEG_RUNTIME_FILES@)
            get_filename_component(
                _katana_ffmpeg_runtime_name
                "${_katana_ffmpeg_runtime_file}"
                NAME
            )
            _katana_add_ffmpeg_runtime_output(
                "${_katana_ffmpeg_runtime_file}"
                "${_katana_ffmpeg_runtime_name}"
            )
        endforeach()
        _katana_add_ffmpeg_runtime_output(
            "@KATANA_FFMPEG_ROOT@/LICENSE.txt"
            "FFmpeg-LGPL.txt"
        )
        _katana_add_ffmpeg_runtime_output(
            "@KATANA_FFMPEG_NOTICE_FILE@"
            "FFmpeg-NOTICE.txt"
        )
        _katana_add_ffmpeg_runtime_output(
            "@KATANA_FFMPEG_BUILD_CONFIGURATION_FILE@"
            "FFmpeg-BUILD-CONFIGURATION.txt"
        )
        _katana_add_ffmpeg_runtime_output(
            "@KATANA_FFMPEG_REDISTRIBUTION_FILE@"
            "@KATANA_FFMPEG_REDISTRIBUTION_FILENAME@"
        )
        set(_katana_ffmpeg_cleanup_stamp
            "${CMAKE_BINARY_DIR}/.katana-ffmpeg-runtime-cleanup")
        add_custom_command(
            OUTPUT "${_katana_ffmpeg_cleanup_stamp}"
            COMMAND ${CMAKE_COMMAND} -E rm -f
                "${CMAKE_BINARY_DIR}/FFmpeg-Corresponding-Source.zip"
                "${CMAKE_BINARY_DIR}/FFmpeg-DEVELOPMENT-ONLY.txt"
            COMMAND ${CMAKE_COMMAND} -E touch
                "${_katana_ffmpeg_cleanup_stamp}"
            DEPENDS "${CMAKE_CURRENT_LIST_FILE}"
            COMMENT "Validate pinned FFmpeg redistribution closure"
            VERBATIM
        )
        add_custom_target(
            katana_ffmpeg_runtime_files
            DEPENDS
                ${_katana_ffmpeg_runtime_outputs}
                "${_katana_ffmpeg_cleanup_stamp}"
            COMMENT "Deploy pinned FFmpeg LGPL runtime closure"
            VERBATIM
        )
    endif()
    add_dependencies(KatanaRecomp::KatanaFfmpegBuild katana_ffmpeg_runtime_files)
endif()
