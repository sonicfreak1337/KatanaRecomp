if(NOT WIN32)
    return()
endif()

function(_katana_ffmpeg_import component dll_name library_name)
    if(TARGET KatanaFfmpeg::${component})
        return()
    endif()
    add_library(KatanaFfmpeg::${component} SHARED IMPORTED)
    set_target_properties(
        KatanaFfmpeg::${component}
        PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/${dll_name}"
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/katana-ffmpeg/${library_name}"
    )
endfunction()
_katana_ffmpeg_import(avutil avutil-60.dll avutil.lib)
_katana_ffmpeg_import(swresample swresample-6.dll swresample.lib)
_katana_ffmpeg_import(swscale swscale-9.dll swscale.lib)
_katana_ffmpeg_import(avcodec avcodec-62.dll avcodec.lib)
_katana_ffmpeg_import(avformat avformat-62.dll avformat.lib)
set_property(TARGET KatanaFfmpeg::swresample PROPERTY INTERFACE_LINK_LIBRARIES KatanaFfmpeg::avutil)
set_property(TARGET KatanaFfmpeg::swscale PROPERTY INTERFACE_LINK_LIBRARIES KatanaFfmpeg::avutil)
set_property(TARGET KatanaFfmpeg::avcodec PROPERTY INTERFACE_LINK_LIBRARIES "KatanaFfmpeg::avutil;KatanaFfmpeg::swresample")
set_property(TARGET KatanaFfmpeg::avformat PROPERTY INTERFACE_LINK_LIBRARIES "KatanaFfmpeg::avcodec;KatanaFfmpeg::avutil")

if(NOT TARGET KatanaFfmpeg::runtime)
    add_library(KatanaFfmpeg::runtime INTERFACE IMPORTED)
    set_property(
        TARGET KatanaFfmpeg::runtime
        PROPERTY INTERFACE_LINK_LIBRARIES
            "KatanaFfmpeg::avformat;KatanaFfmpeg::avcodec;KatanaFfmpeg::avutil;KatanaFfmpeg::swresample;KatanaFfmpeg::swscale"
    )
endif()

function(katana_deploy_ffmpeg_runtime target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "katana_deploy_ffmpeg_runtime target does not exist: ${target}")
    endif()
    get_filename_component(
        _katana_ffmpeg_package_prefix
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.."
        ABSOLUTE
    )
    add_custom_command(
        TARGET "${target}"
        POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            $<TARGET_RUNTIME_DLLS:${target}>
            $<TARGET_FILE_DIR:${target}>
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${_katana_ffmpeg_package_prefix}/@CMAKE_INSTALL_DATADIR@/KatanaRecomp/licenses/FFmpeg-LGPL.txt"
            "$<TARGET_FILE_DIR:${target}>/FFmpeg-LGPL.txt"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${_katana_ffmpeg_package_prefix}/@CMAKE_INSTALL_DATADIR@/KatanaRecomp/licenses/FFmpeg-NOTICE.txt"
            "$<TARGET_FILE_DIR:${target}>/FFmpeg-NOTICE.txt"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${_katana_ffmpeg_package_prefix}/@CMAKE_INSTALL_DATADIR@/KatanaRecomp/licenses/FFmpeg-BUILD-CONFIGURATION.txt"
            "$<TARGET_FILE_DIR:${target}>/FFmpeg-BUILD-CONFIGURATION.txt"
        COMMAND ${CMAKE_COMMAND} -E rm -f
            "$<TARGET_FILE_DIR:${target}>/FFmpeg-Corresponding-Source.zip"
            "$<TARGET_FILE_DIR:${target}>/FFmpeg-DEVELOPMENT-ONLY.txt"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "${_katana_ffmpeg_package_prefix}/@CMAKE_INSTALL_DATADIR@/KatanaRecomp/licenses/@KATANA_FFMPEG_REDISTRIBUTION_FILENAME@"
            "$<TARGET_FILE_DIR:${target}>/@KATANA_FFMPEG_REDISTRIBUTION_FILENAME@"
        COMMAND_EXPAND_LISTS
        VERBATIM
    )
endfunction()

if(NOT TARGET katana_ffmpeg_runtime_files)
    function(_katana_add_packaged_ffmpeg_runtime_output source destination_name)
        set(_katana_ffmpeg_output
            "${CMAKE_BINARY_DIR}/${destination_name}")
        add_custom_command(
            OUTPUT "${_katana_ffmpeg_output}"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "${source}"
                "${_katana_ffmpeg_output}"
            DEPENDS "${source}"
            COMMENT "Deploy pinned FFmpeg runtime file ${destination_name}"
            VERBATIM
        )
        set(_katana_ffmpeg_runtime_outputs
            ${_katana_ffmpeg_runtime_outputs}
            "${_katana_ffmpeg_output}"
            PARENT_SCOPE
        )
    endfunction()

    set(_katana_ffmpeg_runtime_outputs)
    foreach(_katana_ffmpeg_runtime_name IN ITEMS
            avformat-62.dll
            avcodec-62.dll
            avutil-60.dll
            swresample-6.dll
            swscale-9.dll)
        _katana_add_packaged_ffmpeg_runtime_output(
            "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/${_katana_ffmpeg_runtime_name}"
            "${_katana_ffmpeg_runtime_name}"
        )
    endforeach()
    _katana_add_packaged_ffmpeg_runtime_output(
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/KatanaRecomp/licenses/FFmpeg-LGPL.txt"
        "FFmpeg-LGPL.txt"
    )
    _katana_add_packaged_ffmpeg_runtime_output(
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/KatanaRecomp/licenses/FFmpeg-NOTICE.txt"
        "FFmpeg-NOTICE.txt"
    )
    _katana_add_packaged_ffmpeg_runtime_output(
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/KatanaRecomp/licenses/FFmpeg-BUILD-CONFIGURATION.txt"
        "FFmpeg-BUILD-CONFIGURATION.txt"
    )
    _katana_add_packaged_ffmpeg_runtime_output(
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/KatanaRecomp/licenses/@KATANA_FFMPEG_REDISTRIBUTION_FILENAME@"
        "@KATANA_FFMPEG_REDISTRIBUTION_FILENAME@"
    )
    set(_katana_ffmpeg_cleanup_stamp
        "${CMAKE_BINARY_DIR}/.katana-ffmpeg-runtime-cleanup")
    add_custom_command(
        OUTPUT "${_katana_ffmpeg_cleanup_stamp}"
        COMMAND ${CMAKE_COMMAND} -E rm -f
            "${CMAKE_BINARY_DIR}/FFmpeg-Corresponding-Source.zip"
            "${CMAKE_BINARY_DIR}/FFmpeg-DEVELOPMENT-ONLY.txt"
        COMMAND ${CMAKE_COMMAND} -E touch
            "${_katana_ffmpeg_cleanup_stamp}"
        DEPENDS "${CMAKE_CURRENT_LIST_FILE}"
        COMMENT "Validate pinned FFmpeg redistribution closure"
        VERBATIM
    )
    add_custom_target(
        katana_ffmpeg_runtime_files
        DEPENDS
            ${_katana_ffmpeg_runtime_outputs}
            "${_katana_ffmpeg_cleanup_stamp}"
        COMMENT "Deploy pinned FFmpeg LGPL runtime closure"
        VERBATIM
    )
endif()
add_dependencies(KatanaFfmpeg::runtime katana_ffmpeg_runtime_files)
